@component('components/layout', { title: 'Accueil' })
  <h1>Mes decks</h1>
  
  <div class="decks-grid">
    @each ((deck, index) in decks)
      <a href="{{ route('deck.show', { id: deck.id }) }}" class="deck-card">
        <h2 class="deck-card-title">{{ deck.title }}</h2>
        <p class="deck-card-description">{{ deck.description }}</p>
        <div class="deck-card-footer">
          <span class="deck-card-count">Cartes: {{ deck.$extras.nbrOfCards }}</span>
        </div>
      </a>
    @end
  </div>
  
  <a href="{{ route('deck.create') }}" class="btn" >Ajouter un deck</a>
@endcomponent