@component('components/layout', { title: 'Créer un deck' })
  <div class="form-container">
    <div class="form-header">
      <h1>
        Créer un nouveau deck
      </h1>
    </div>

    <form action="{{ route('deck.store') }}" method="POST">
      {{ csrfField() }}
      <div class="form-group">
        <label for="title">Titre du deck</label>
        <input
          type="text"
          id="title"
          name="title"
          value="{{ old('title') || '' }}"
          placeholder="Ex: Vocabulaire anglais"
          required
        />
        @inputError('title')
          <p class="error-message">
            {{ $messages.join(', ') }}
          </p>
        @end
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" placeholder="Décrivez brièvement votre deck...">{{ old('description') || '' }}</textarea>
        @inputError('description')
          <p class="error-message">
            {{ $messages.join(', ') }}
          </p>
        @end
      </div>

      <div class="form-actions">
        <a href="{{ route('home') }}" class="btn btn-secondary">Abandonner</a>
        <button type="submit" class="btn btn-primary">Créer le deck</button>
      </div>
    </form>
  </div>
@endcomponent
