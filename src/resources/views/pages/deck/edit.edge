@component('components/layout', { title: 'Créer un deck' })
  <div class="form-container">
    <div class="form-header">
      <h1>
        Créer un nouveau deck
      </h1>
    </div>

    <form action="{{ route('deck.update', { id: deck.id }) }}?_method=PUT" method="POST">
      {{ csrfField() }}
      <div class="form-group">
        <label for="title">Titre du deck</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="Ex: Vocabulaire anglais"
          required
          value="{{ old('title') || deck.title }}"
        />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" placeholder="Décrivez brièvement votre deck...">{{ old('description') || deck.description }}</textarea>
      </div>

      <div class="form-actions">
        <a href="{{ route('deck.show', { id: deck.id }) }}" class="btn btn-secondary">Abandonner</a>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
@endcomponent
