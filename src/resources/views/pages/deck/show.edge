@component('components/layout', { title: deck.title })

  <div class="deck-header">
    <div class="deck-header-top">
      <div class="deck-info">
        <h1>
          {{ deck.title }}
        </h1>
        <p>
          {{ deck.description }}
        </p>
      </div>
      <div class="deck-actions">
        <button class="btn-icon btn-exercise">Exercer</button>
        <a href="{{ route('deck.edit', {id: deck.id}) }}" class="btn-icon">Modifier</a>
        <a class="btn-icon btn-danger" onclick="document.querySelector('.modal-overlay').style.display = 'flex'">Supprimer</a>
      </div>
    </div>
  </div>

  <div class="cards-section">
    <div class="cards-header">
      <h2>
        Cartes du deck
      </h2>
      <button class="btn-icon">Ajouter une carte</button>
    </div>

    <div class="cards-list">
      <div class="card-item">
        <div class="card-item-question">
          Canada
        </div>
        <div class="card-item-answer">
          Ottawa
        </div>
      </div>

      <div class="card-item">
        <div class="card-item-question">
          Australie
        </div>
        <div class="card-item-answer">
          Canberra
        </div>
      </div>

      <div class="card-item">
        <div class="card-item-question">
          Japon
        </div>
        <div class="card-item-answer">
          Tokyo
        </div>
      </div>
      <div class="modal-overlay">
        <div class="modal">
          <div class="modal-header">
            <h3>
              Confirmer la suppression
            </h3>
          </div>
          <div class="modal-body">
            <p>
              Voulez-vous vraiment supprimer ce deck ?
            </p>
          </div>
          <div class="modal-actions">
            <button class="btn btn-secondary" onclick="document.querySelector('.modal-overlay').style.display = 'none'">Annuler</button>
            <form action="{{ route('deck.destroy', { id: deck.id }) }}?_method=DELETE" method="POST">
              {{ csrfField() }}
            <button type="submit" class="btn-icon btn-danger">
                Continuer
            </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
@endcomponent